      "refersTo": "scope-value",
      "description": "Static scope indicator, not an interactive filter.",
      "html": "<span class=\"ds-scope\">All time</span>",
      "css": ".ds-scope{font-family:\"Source Sans 3\",sans-serif;font-size:16px;color:#20312d;display:inline-block;background:var(--selection,#e5edf8);color:var(--blue,#193f72);border-radius:6px;padding:7px 14px;font-weight:600}@media(max-width:700px){.ds-scope{padding:6px 10px}}"
    },
