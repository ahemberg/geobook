      "kind": "custom",
      "refersTo": "track-row",
      "description": "Saved-colour swatch, track name and recorded point count; colour here is synthetic sample data.",
      "html": "<button class=\"ds-track\" aria-pressed=\"true\"><span class=\"ds-swatch\"></span><span class=\"ds-label\"><strong>Synthetic waterfront walk</strong><span>5 recorded points</span></span></button>",
      "css": ".ds-track{font-family:\"Source Sans 3\",sans-serif;font-size:16px;color:#20312d;border:1px solid #9baca4;border-radius:6px;padding:10px 14px;min-height:44px;background:var(--surface,#fff);cursor:pointer;display:flex;gap:12px;text-align:left;align-items:center;width:100%;border:0;border-bottom:1px solid var(--line,#d8e1dc);border-radius:0;padding:16px 20px;background:var(--selection,#e5edf8)}.ds-track:hover{background:var(--selection,#e5edf8)}.ds-track:focus-visible{outline:3px solid #2768ba;outline-offset:3px;}.ds-swatch{width:10px;height:10px;border-radius:50%;flex-shrink:0;background:#ad466a}.ds-label{min-width:0;display:grid;gap:4px}.ds-label strong{overflow-wrap:anywhere;font-weight:600}.ds-label>span{font-size:14px;color:var(--muted,#52645e)}"
    },
    {
      "name": "Recording details",
      "kind": "custom",
      "refersTo": "track-detail",
      "description": "Flat detail panel with original-export link; no plot or playback controls.",
      "html": "<section class=\"ds-detail\" aria-label=\"Complete recording\"><h2>Synthetic waterfront walk</h2><p>Complete recording \u00b7 5 points \u00b7 1 segment</p><p class=\"ds-hint\">Lines break at source segments and recording gaps over five minutes.</p><a href=\"#original-export\">Download GPX</a></section>",
      "css": ".ds-detail{font-family:\"Source Sans 3\",sans-serif;font-size:16px;color:#20312d;padding:22px 24px;border-top:1px solid var(--line,#d8e1dc);background:var(--surface,#fff);overflow-wrap:anywhere}.ds-detail h2{margin:0;font-size:22px;font-weight:600;text-wrap:balance}.ds-detail p{margin:8px 0;line-height:1.5;max-width:70ch}.ds-hint{font-size:14px;color:var(--muted,#52645e)}.ds-detail a{color:var(--blue,#193f72);text-underline-offset:3px}.ds-detail a:hover{text-decoration-thickness:2px}.ds-detail a:focus-visible{outline:3px solid #2768ba;outline-offset:3px;}@media(max-width:700px){.ds-detail{padding:18px 16px}}"
    },
