  "narrative": {
    "northStar": "Travel timetable",
    "overview": "Geobook puts a detailed travel map beside a compact library. A blue header anchors the page; white panels and pale blue selection keep saved recordings easy to scan. Source Sans 3 carries headings, controls and recording details.\n\nThis system records the rendered issue #24 implementation. The [approved MVP brief](docs/design/mvp.md) remains the authority for later search, date and country filters, track editing and playback. Those controls are not implemented conventions yet.",
    "keyCharacteristics": [
      "Map beside the library on desktop, above it on mobile.",
      "Saved track colours connect library swatches and map geometry.",
      "Flat panels, visible dividers and labelled controls."
    ],
    "rules": [
      {
        "name": "The Saved Colour Rule",
        "body": "A track's saved colour connects its swatch and map geometry; status colours describe application feedback.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the saved track colour across the library and map.",
      "Do keep keyboard focus, map attribution and labelled touch controls visible.",
      "Do let track names wrap and keep supporting counts readable.",
      "Do use synthetic recordings in public examples."
    ],
    "donts": [
      "Don't treat planned search, date filters or playback as existing components.",
      "Don't substitute schematic geography for the application's detailed map.",
      "Don't use track colour alone to communicate an error or warning."
    ]
  }
}
