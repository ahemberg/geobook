    },
    {
      "name": "Header",
      "kind": "custom",
      "description": "Wordmark and current-page label; Map is static in this slice.",
      "html": "<header class=\"ds-header\"><span class=\"ds-brand\">Geobook</span><span class=\"ds-current\">Map</span></header>",
      "css": ".ds-header{font-family:\"Source Sans 3\",sans-serif;font-size:16px;color:#20312d;height:76px;display:flex;gap:32px;align-items:center;background:var(--blue,#193f72);color:#fff;padding:0 26px}.ds-brand{font-size:28px;font-weight:700;letter-spacing:-.02em}.ds-current{font-weight:600;padding:8px 2px;border-bottom:2px solid #bcd4f5}@media(max-width:700px){.ds-header{height:64px;padding:0 16px;gap:20px}.ds-brand{font-size:25px}.ds-current{display:none}}"
    },
