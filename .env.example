# Use the exact tag you built or pulled. See docs/deployment.md.
GEOBOOK_IMAGE=geobook:VERSION
GEOBOOK_DATA_DIRECTORY=/mnt/ssd/geobook
GEOBOOK_UID=10001
GEOBOOK_GID=10001
# Set your LAN or VPN interface address to allow access from other devices.
GEOBOOK_BIND_ADDRESS=127.0.0.1
GEOBOOK_PORT=8080
# Maximum upload size in MB, including multipart request overhead.
GEOBOOK_UPLOAD_LIMIT_MB=512

# password (default) makes the owner sign in. public turns login off; use it only on a trusted network.
GEOBOOK_AUTH_MODE=password
GEOBOOK_OWNER_USER=admin
# Used only while the owner has no password: 8 characters to 72 bytes, or a bcrypt hash.
# Put a bcrypt hash in single quotes so Compose leaves its $ signs alone.
GEOBOOK_OWNER_PASSWORD=
# Session max age and idle timeout, in seconds or with a d, h, m or s suffix.
#GEOBOOK_SESSION_MAXAGE=14d
#GEOBOOK_SESSION_TIMEOUT=7d
# Reverse proxies allowed to set X-Forwarded-For and X-Forwarded-Proto, as IP addresses or CIDRs.
#GEOBOOK_TRUSTED_PROXIES=172.16.0.0/12

GEOBOOK_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOBOOK_TILES_ATTRIBUTION=© OpenStreetMap contributors
GEOBOOK_TILES_ATTRIBUTIONURL=https://www.openstreetmap.org/copyright
